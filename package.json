{
  "name": "mokky-buddy-api-runner",
  "displayName": "Mokky Buddy - Cloud API Manager",
  "description": "Cloud-native API mock manager for MokkyBuddy SaaS platform. Create, edit, and manage mock APIs directly from VS Code.",
  "version": "3.0.0",
  "publisher": "StapeDev",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/stapeDev/it.stapedev.vscode.mokkybuddy.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Developer Tools"
  ],
  "files": [
    "dist",
    "resources/logo.png",
    "resources/icon.svg",
    "LICENSE"
  ],
  "activationEvents": [
    "onCommand:mokkyBuddy.setApiKey",
    "onCommand:mokkyBuddy.clearApiKey",
    "onCommand:mokkyBuddy.createServer",
    "onCommand:mokkyBuddy.deleteServer",
    "onCommand:mokkyBuddy.createRoute",
    "onCommand:mokkyBuddy.editRoute",
    "onCommand:mokkyBuddy.deleteRoute",
    "onCommand:mokkyBuddy.testRoute",
    "onCommand:mokkyBuddy.refreshServers",
    "onCommand:mokkyBuddy.selectEnvironment",
    "onView:mokkyBuddyServerView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mokkyBuddy",
          "title": "Mokky Buddy",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mokkyBuddy": [
        {
          "id": "mokkyBuddyServerView",
          "name": "Servers & Routes",
          "icon": "resources/icon.svg",
          "contextualTitle": "MokkyBuddy Cloud Platform"
        }
      ]
    },
    "commands": [
      {
        "command": "mokkyBuddy.setApiKey",
        "title": "Set API Key",
        "category": "MokkyBuddy",
        "icon": "$(key)"
      },
      {
        "command": "mokkyBuddy.clearApiKey",
        "title": "Clear API Key",
        "category": "MokkyBuddy",
        "icon": "$(close)"
      },
      {
        "command": "mokkyBuddy.createServer",
        "title": "Create New Server",
        "category": "MokkyBuddy",
        "icon": "$(add)"
      },
      {
        "command": "mokkyBuddy.deleteServer",
        "title": "Delete Server",
        "category": "MokkyBuddy",
        "icon": "$(trash)"
      },
      {
        "command": "mokkyBuddy.createRoute",
        "title": "Create New Route",
        "category": "MokkyBuddy",
        "icon": "$(add)"
      },
      {
        "command": "mokkyBuddy.editRoute",
        "title": "Edit Route",
        "category": "MokkyBuddy",
        "icon": "$(edit)"
      },
      {
        "command": "mokkyBuddy.deleteRoute",
        "title": "Delete Route",
        "category": "MokkyBuddy",
        "icon": "$(trash)"
      },
      {
        "command": "mokkyBuddy.testRoute",
        "title": "Test Route",
        "category": "MokkyBuddy",
        "icon": "$(play)"
      },
      {
        "command": "mokkyBuddy.refreshServers",
        "title": "Refresh Servers",
        "category": "MokkyBuddy",
        "icon": "$(refresh)"
      },
      {
        "command": "mokkyBuddy.selectEnvironment",
        "title": "Select Environment",
        "category": "MokkyBuddy",
        "icon": "$(server-environment)"
      },
      {
        "command": "mokkyBuddy.insertSnippet",
        "title": "Insert Route Snippet",
        "category": "MokkyBuddy",
        "icon": "$(code)",
        "when": "resourceExtname == .json"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mokkyBuddy.setApiKey",
          "when": "view == mokkyBuddyServerView && !mokkyBuddy.hasApiKey",
          "group": "navigation@1"
        },
        {
          "command": "mokkyBuddy.clearApiKey",
          "when": "view == mokkyBuddyServerView && mokkyBuddy.hasApiKey",
          "group": "navigation@1"
        },
        {
          "command": "mokkyBuddy.refreshServers",
          "when": "view == mokkyBuddyServerView && mokkyBuddy.hasApiKey",
          "group": "navigation@2"
        },
        {
          "command": "mokkyBuddy.createServer",
          "when": "view == mokkyBuddyServerView && mokkyBuddy.hasApiKey",
          "group": "navigation@3"
        },
        {
          "command": "mokkyBuddy.createRoute",
          "when": "view == mokkyBuddyServerView && mokkyBuddy.hasApiKey",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "mokkyBuddy.deleteServer",
          "when": "view == mokkyBuddyServerView && viewItem == serverNode",
          "group": "inline@1"
        },
        {
          "command": "mokkyBuddy.createRoute",
          "when": "view == mokkyBuddyServerView && viewItem == serverNode",
          "group": "inline@2"
        },
        {
          "command": "mokkyBuddy.editRoute",
          "when": "view == mokkyBuddyServerView && viewItem == routeNode",
          "group": "inline@1"
        },
        {
          "command": "mokkyBuddy.testRoute",
          "when": "view == mokkyBuddyServerView && viewItem == routeNode",
          "group": "inline@2"
        },
        {
          "command": "mokkyBuddy.deleteRoute",
          "when": "view == mokkyBuddyServerView && viewItem == routeNode",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "MokkyBuddy Settings",
      "properties": {
        "mokkyBuddy.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for MokkyBuddy SaaS platform",
          "scope": "application"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "*.mokky.json",
        "url": "./schemas/mokkybuddy-route.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package-prod",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package-prod": "npm run check-types && npm run lint && node esbuild.js --minify",
    "compile-tests": "tsc -p . --outDir dist",
    "watch-tests": "tsc -p . -w --outDir dist",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --config jest.config.js --runInBand"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vscode/test-electron": "^2.4.5",
    "chai": "^5.1.2",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "jest": "^30.0.0-alpha.7",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^30.0.0-alpha.6",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
