{
  "name": "mokky-buddy-api-runner",
  "displayName": "Mokky Buddy API Runner",
  "description": "Run and manage mock APIs locally or in the cloud with SAAS mode",
  "version": "2.0.0",
  "publisher": "StapeDev",
  "icon": "resources/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/stapeDev/it.stapedev.vscode.mokkybuddy.git"
  },
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other"
  ],
  "files": [
    "dist",
    "resources/mokkyBuddyAPI.jar",
    "resources/logo.png",
    "resources/icon.svg",
    "vss-extension.json",
    "LICENSE"
  ],
  "activationEvents": [
    "onCommand:mokkyBuddyAPIRunner.toggleServer",
    "onCommand:mokkyBuddyAPIRunner.addAPI",
    "onCommand:mokkyBuddyAPIRunner.deleteAPI",
    "onCommand:mokkyBuddyAPIRunner.previewJson",
    "onCommand:mokkyBuddyAPIRunner.saveAPIConfig",
    "onCommand:mokkyBuddyAPIRunner.loadAPIConfig",
    "onCommand:mokkyBuddyAPIRunner.changePort",
    "onCommand:mokkyBuddyAPIRunner.setApiKey",
    "onCommand:mokkyBuddyAPIRunner.clearApiKey",
    "onCommand:mokkyBuddyAPIRunner.createServer",
    "onCommand:mokkyBuddyAPIRunner.deleteServer",
    "onCommand:mokkyBuddyAPIRunner.syncRoutes",
    "onCommand:mokkyBuddyAPIRunner.showKpi",
    "onView:mokkyBuddyServerView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mokkyBuddy",
          "title": "Mokky Buddy",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mokkyBuddy": [
        {
          "id": "mokkyBuddyServerView",
          "name": "Server"
        }
      ]
    },
    "commands": [
      {
        "command": "mokkyBuddyAPIRunner.toggleServer",
        "title": "Start/Stop Mokky Buddy Server"
      },
      {
        "command": "mokkyBuddyAPIRunner.addAPI",
        "title": "Add API Route"
      },
      {
        "command": "mokkyBuddyAPIRunner.deleteAPI",
        "title": "Delete API Route"
      },
      {
        "command": "mokkyBuddyAPIRunner.previewJson",
        "title": "Preview JSON"
      },
      {
        "command": "mokkyBuddyAPIRunner.saveAPIConfig",
        "title": "Save API Config"
      },
      {
        "command": "mokkyBuddyAPIRunner.loadAPIConfig",
        "title": "Load API Config"
      },
      {
        "command": "mokkyBuddyAPIRunner.changePort",
        "title": "MokkyBuddy: Set Server Port"
      },
      {
        "command": "mokkyBuddyAPIRunner.selectApiMode",
        "title": "MokkyBuddy: Select API Mode"
      },
      {
        "command": "mokkyBuddyAPIRunner.setApiKey",
        "title": "MokkyBuddy: Set API Key",
        "icon": "$(key)"
      },
      {
        "command": "mokkyBuddyAPIRunner.clearApiKey",
        "title": "MokkyBuddy: Clear API Key",
        "icon": "$(close)"
      },
      {
        "command": "mokkyBuddyAPIRunner.createServer",
        "title": "MokkyBuddy: Create New Server",
        "icon": "$(add)"
      },
      {
        "command": "mokkyBuddyAPIRunner.deleteServer",
        "title": "MokkyBuddy: Delete Server",
        "icon": "$(trash)"
      },
      {
        "command": "mokkyBuddyAPIRunner.syncRoutes",
        "title": "MokkyBuddy: Sync Routes to Cloud",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mokkyBuddyAPIRunner.showKpi",
        "title": "MokkyBuddy: Show KPI Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "mokkyBuddyAPIRunner.refreshServers",
        "title": "MokkyBuddy: Refresh Servers",
        "icon": "$(refresh)"
      },
      {
        "command": "mokkyBuddyAPIRunner.editRoute",
        "title": "MokkyBuddy: Edit Route"
      },
      {
        "command": "mokkyBuddyAPIRunner.selectEnvironment",
        "title": "MokkyBuddy: Select Environment",
        "icon": "$(server-environment)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mokkyBuddyAPIRunner.refreshServers",
          "when": "view == mokkyBuddyServerView",
          "group": "navigation"
        },
        {
          "command": "mokkyBuddyAPIRunner.selectEnvironment",
          "when": "view == mokkyBuddyServerView",
          "group": "navigation"
        },
        {
          "command": "mokkyBuddyAPIRunner.setApiKey",
          "when": "view == mokkyBuddyServerView && !mokkyBuddy.hasApiKey",
          "group": "navigation"
        },
        {
          "command": "mokkyBuddyAPIRunner.clearApiKey",
          "when": "view == mokkyBuddyServerView && mokkyBuddy.hasApiKey",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mokkyBuddyAPIRunner.changePort",
          "when": "view == mokkyBuddyServerView && viewItem == serverNode",
          "group": "inline"
        },
        {
          "command": "mokkyBuddyAPIRunner.deleteServer",
          "when": "view == mokkyBuddyServerView && viewItem == saasServerNode",
          "group": "inline"
        },
        {
          "command": "mokkyBuddyAPIRunner.syncRoutes",
          "when": "view == mokkyBuddyServerView && viewItem == serverNode && mokkyBuddy.hasApiKey",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Mokky Buddy Settings",
      "properties": {
        "mokkyBuddy.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Full path to the Java executable to use for starting the Mokky Buddy server."
        },
        "mokkyBuddy.serverPort": {
          "type": "number",
          "default": 8081,
          "description": "Port on which the Mokky Buddy server will run (file/database mode)"
        },
        "mokkyBuddy.apiMode": {
          "type": "string",
          "enum": [
            "file",
            "database",
            "saas"
          ],
          "enumDescriptions": [
            "Store APIs in local JSON files",
            "Store APIs in local H2 database",
            "Connect to MokkyBuddy cloud platform"
          ],
          "default": "file",
          "description": "Select how Mokky Buddy APIs are stored and managed."
        },
        "mokkyBuddy.saas.environment": {
          "type": "string",
          "enum": [
            "local",
            "dev",
            "test",
            "prod"
          ],
          "enumDescriptions": [
            "Local development (localhost:8090)",
            "Development server",
            "Test/Staging server",
            "Production server"
          ],
          "default": "local",
          "description": "Select the SAAS environment to connect to"
        },
        "mokkyBuddy.saas.endpoints.local.gatewayUrl": {
          "type": "string",
          "default": "http://localhost:8090",
          "description": "Gateway URL for LOCAL environment"
        },
        "mokkyBuddy.saas.endpoints.local.mockServerBaseUrl": {
          "type": "string",
          "default": "http://localhost:8083",
          "description": "Mock server base URL for LOCAL environment"
        },
        "mokkyBuddy.saas.endpoints.dev.gatewayUrl": {
          "type": "string",
          "default": "https://gateway.dev.mokkybuddy.stapedev.it",
          "description": "Gateway URL for DEV environment"
        },
        "mokkyBuddy.saas.endpoints.dev.mockServerBaseUrl": {
          "type": "string",
          "default": "https://mock.dev.mokkybuddy.stapedev.it",
          "description": "Mock server base URL for DEV environment"
        },
        "mokkyBuddy.saas.endpoints.test.gatewayUrl": {
          "type": "string",
          "default": "https://gateway.test.mokkybuddy.stapedev.it",
          "description": "Gateway URL for TEST environment"
        },
        "mokkyBuddy.saas.endpoints.test.mockServerBaseUrl": {
          "type": "string",
          "default": "https://mock.test.mokkybuddy.stapedev.it",
          "description": "Mock server base URL for TEST environment"
        },
        "mokkyBuddy.saas.endpoints.prod.gatewayUrl": {
          "type": "string",
          "default": "https://gateway.mokkybuddy.stapedev.it",
          "description": "Gateway URL for PROD environment"
        },
        "mokkyBuddy.saas.endpoints.prod.mockServerBaseUrl": {
          "type": "string",
          "default": "https://mock.mokkybuddy.stapedev.it",
          "description": "Mock server base URL for PROD environment"
        },
        "mokkyBuddy.saas.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for authenticating with MokkyBuddy SAAS platform"
        },
        "mokkyBuddy.saas.mockServerBaseUrl": {
          "type": "string",
          "default": "https://mock.mokkybuddy.stapedev.it",
          "description": "Base URL for accessing mock servers in SAAS mode"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-prod",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "package-prod": "npm run check-types && npm run lint && node esbuild.js --minify",
    "compile-tests": "tsc -p . --outDir dist",
    "watch-tests": "tsc -p . -w --outDir dist",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest --config jest.config.js --runInBand"
  },
  "devDependencies": {
    "@types/form-data": "^2.5.2",
    "@types/chai": "^5.2.2",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.104.0",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/parser": "^8.41.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@vscode/test-electron": "^2.5.2",
    "chai": "^4.5.0",
    "esbuild": "^0.25.9",
    "jest": "^30.1.3",
    "eslint": "^9.36.0",
    "mocha": "^11.7.2",
    "sinon": "^21.0.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "form-data": "^4.0.4",
    "node-fetch": "^2.7.0"
  }
}
